{
  "displayName": "ElderGuard: Cloud Run startup latency p95 over 8 s",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "startup p95 > 8000 ms",
      "conditionThreshold": {
        "filter": "metric.type = \"run.googleapis.com/container/startup_latencies\" AND resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"__SERVICE__\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 8000,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "enabled": true,
  "documentation": {
    "content": "Cold starts are approaching Twilio's 15 s webhook timeout. Check min-instances=1 and startup CPU boost in cloudrun.yaml.",
    "mimeType": "text/markdown"
  },
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
