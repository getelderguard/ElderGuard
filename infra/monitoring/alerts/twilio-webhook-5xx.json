{
  "displayName": "ElderGuard: Twilio webhooks returning non-2xx",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "5xx on /twilio/* in 5 min",
      "conditionThreshold": {
        "filter": "metric.type = \"logging.googleapis.com/user/elderguard_twilio_5xx\" AND resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"__SERVICE__\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "enabled": true,
  "documentation": {
    "content": "Twilio saw errors from /twilio/voice/*. Callers hear the fallback notice. Check Cloud Run logs for the failing route.",
    "mimeType": "text/markdown"
  },
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
