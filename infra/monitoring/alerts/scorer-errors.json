{
  "displayName": "ElderGuard: scorer error rate high",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "scorer failures > 5 in 10 min",
      "conditionThreshold": {
        "filter": "metric.type = \"logging.googleapis.com/user/elderguard_scorer_failures\" AND resource.type = \"cloud_run_revision\" AND resource.labels.service_name = \"__SERVICE__\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 5,
        "duration": "0s",
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "perSeriesAligner": "ALIGN_SUM"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "__CHANNEL__"
  ],
  "enabled": true,
  "documentation": {
    "content": "Scorer provider failures. Tiers show Unknown. Check the Anthropic status page and the org spend limit, then flip the scorer with infra/scripts/set_provider.py.",
    "mimeType": "text/markdown"
  },
  "alertStrategy": {
    "autoClose": "1800s"
  }
}
