# Copy this file to .env and fill in real values. .env is gitignored; never commit real keys.
# Every value here is a placeholder. A forker provisions their own accounts for each.

ENV=dev
LOG_LEVEL=INFO

# Public HTTPS origin Twilio calls back to. ngrok URL in local dev, Cloud Run URL or api.elderguard.org later.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Comma-separated browser origins allowed to call the API. Empty = no CORS at all.
CORS_ORIGINS=

# GCP / Firebase project id. Required when STORE=firestore, AUTH_MODE=firebase, or NOTIFY=fcm.
GCP_PROJECT=
# memory (local) or firestore (prod). Prod refuses memory.
STORE=memory
# dev (X-Dev-Uid / X-Dev-Phone headers, refused in prod) or firebase (verifies Firebase ID tokens).
AUTH_MODE=dev
# log (local) or fcm (real pushes through Firebase Cloud Messaging).
NOTIFY=log
# Service-account email Cloud Scheduler uses to call /internal/*. Empty disables those routes.
SCHEDULER_SERVICE_ACCOUNT=
# Seconds the Firestore config overlay (providers, limits, flags, kill switch) is cached.
CONFIG_CACHE_SECONDS=30
# Optional Sentry DSN. Events are scrubbed of transcript and phone fields before sending.
SENTRY_DSN=

# Anthropic API key for scam scoring. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Streaming transcription key (Deepgram by default). https://console.deepgram.com
STT_API_KEY=your-stt-api-key-here

# Twilio account used for the Guardian Line. https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
# The Guardian Line number in E.164, e.g. +14155550100
TWILIO_GUARDIAN_NUMBER=+10000000000

# Random secrets. Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
PHONE_HASH_PEPPER=replace-with-64-hex-chars
STREAM_TOKEN_SECRET=replace-with-64-hex-chars

# "1" runs the whole backend with deterministic fake providers and no credentials. "fail" makes them fail.
FAKE_PROVIDERS=
# Comma-separated E.164 numbers treated as enrolled seniors until Firestore accounts exist (M1).
DEV_ALLOWED_PHONES=
